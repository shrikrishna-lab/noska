# Noska environment variables
# Copy this file to `.env` for local development and set the same variables
# in your Vercel project settings (Settings -> Environment Variables) for production.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key (safe for the browser; scoped by RLS)
VITE_SUPABASE_ANON_KEY=

# ⚠️ DO NOT set VITE_TEST_MODE in production. It bypasses authentication and
# loads data straight from localStorage — for local end-to-end testing only.
# VITE_TEST_MODE=true
