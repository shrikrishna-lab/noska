# ─── Noska Environment Variables ────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# Set the same variables in Vercel (Settings → Environment Variables) for prod.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Anon / publishable key (safe for browser; scoped by RLS)
VITE_SUPABASE_ANON_KEY=

# Service role key (server-side only — NEVER expose to browser)
# Required by: send-email, clerk-webhook, waitlist-signup, resend-webhook
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ────────────────────────────────────────────────────────────────────
# Publishable key from Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=

# Secret key from Clerk Dashboard → API Keys
# Required by: waitlist-signup edge function
# CLERK_SECRET_KEY=

# Webhook signing secret from Clerk Dashboard → Webhooks
# Required by: clerk-webhook edge function
# CLERK_WEBHOOK_SECRET=

# ── Resend (Email) ───────────────────────────────────────────────────────────
# API key from Resend Dashboard → API Keys
# Alternatively, set via Admin → Settings → Email in the admin panel
# RESEND_API_KEY=

# Verified sending domain in Resend
# FROM_EMAIL=

# Webhook signing secret from Resend Dashboard → Webhooks
# RESEND_WEBHOOK_SECRET=

# ── PostHog (Analytics) ──────────────────────────────────────────────────────
# Project API key from PostHog → Project Settings → Project API Key
# VITE_POSTHOG_KEY=

# Self-hosted PostHog host (optional, defaults to https://app.posthog.com)
# VITE_POSTHOG_HOST=

# ── Sentry (Error Tracking) ──────────────────────────────────────────────────
# DSN from Sentry → Project → Client Keys (DSN)
# VITE_SENTRY_DSN=

# Sentry auth token for source map uploads (Sentry → Settings → Auth Tokens)
# SENTRY_AUTH_TOKEN=

# Sentry org slug (Sentry → Settings → General Settings)
# SENTRY_ORG=

# Sentry project slug (Sentry → Projects → select project)
# SENTRY_PROJECT=

# App version (semver, used as Sentry release)
# VITE_APP_VERSION=

# ── Trigger.dev (Background Jobs) ────────────────────────────────────────────
# API key from Trigger.dev Dashboard → Environments
# TRIGGER_API_KEY=

# Trigger.dev API URL (optional, defaults to https://api.trigger.dev)
# TRIGGER_API_URL=

# ── Vercel ───────────────────────────────────────────────────────────────────
# OIDC token for Vercel CLI authentication (local only)
# VERCEL_OIDC_TOKEN=

# ── Admin Panel ──────────────────────────────────────────────────────────────
# When true (dev only), skips real Supabase auth and uses mock data
# VITE_ADMIN_DEMO=true

# ⚠️ DO NOT set VITE_TEST_MODE=true in production
# VITE_TEST_MODE=false
