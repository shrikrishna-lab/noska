# Noska Admin environment
# Copy to .env (gitignored) and fill in real values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Noska app (used for "Direct access link" generation).
# Local dev: https://app.noska.me:5173
VITE_APP_URL=https://app.noska.me

# When true (and dev mode), the admin panel skips real Supabase auth and
# uses a local role-switcher with seeded mock data — useful for preview/
# design reviews without provisioning a separate admin project.
VITE_ADMIN_DEMO=true
