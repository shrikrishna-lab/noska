{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "--isolated=true",
        "--viewport=1400x900"
      ],
      "disabled": true,
      "autoApprove": [
        "navigate_page",
        "new_page",
        "list_pages",
        "select_page",
        "take_snapshot",
        "take_screenshot",
        "evaluate_script",
        "list_console_messages",
        "get_console_message",
        "wait_for",
        "list_network_requests",
        "get_network_request"
      ]
    }
  }
}